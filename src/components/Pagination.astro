---
interface Props {
  page: {
    url: { prev: string | undefined; next: string | undefined };
    currentPage: number;
    lastPage: number;
  };
  sectionColor: string;
}
const { page, sectionColor } = Astro.props;
---
<nav class="flex items-center justify-between mt-12 font-mono text-sm">
  {page.url.prev ? (
    <a href={page.url.prev} class={`hover:${sectionColor} text-steel transition-colors border border-gunmetal px-4 py-2 hover:border-gunmetal/80 bg-gunmetal/20`}>&larr; PREV</a>
  ) : (
    <span class="text-steel/30 border border-transparent px-4 py-2">&larr; PREV</span>
  )}
  
  <span class="text-steel/70 text-xs tracking-widest">PAGE {page.currentPage} OF {page.lastPage}</span>
  
  {page.url.next ? (
    <a href={page.url.next} class={`hover:${sectionColor} text-steel transition-colors border border-gunmetal px-4 py-2 hover:border-gunmetal/80 bg-gunmetal/20`}>NEXT &rarr;</a>
  ) : (
    <span class="text-steel/30 border border-transparent px-4 py-2">NEXT &rarr;</span>
  )}
</nav>
